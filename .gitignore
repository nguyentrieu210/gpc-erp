# Python/runtime cache
__pycache__/
*.py[cod]
*$py.class

# Frontend dependencies and local build cache
node_modules/
.vite/
dist/
*.timestamp-*.mjs

# Generated frontend bundles — KEEP for clone-and-run
# **/public/frontend/assets/

# Shared UI synced into each app (nguồn gốc ở /shared/ui; copy lúc build qua shared/sync.sh)
/apps/*/frontend/src/_shared/

# Local/editor/environment files
.env
.env.*
*.log
.DS_Store
Thumbs.db

# Temporary patch/debug scripts created during development
/patch_*.py
/patch*.py
/apps/fix_*.py
/apps/patch_*.py
/apps/patch*.py
/apps/*/_fix*.py
/apps/*/patch_*.py
/apps/*/patch*.py

# Accidental/generated folder
apps;C/
